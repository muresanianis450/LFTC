Grammar

    0 $accept: program "end of file"

    1 program: const_decls statement statements

    2 statements: statement statements
    3           | %empty

    4 statement: assignment
    5          | input_statement
    6          | if_statement
    7          | for_loop
    8          | print_statement

    9 const_decls: const_decl const_decls
   10            | %empty

   11 const_decl: "Chimpanzini_Bananini" "identifier" "=" const_value

   12 const_value: "string"
   13            | "number"
   14            | "SIXSEVEN"
   15            | "identifier"

   16 assignment: "identifier" "=" list_expression

   17 input_statement: "Tung_Tung_Tung_Sahur" "identifier"

   18 print_statement: "Bombardiro_Crocodilo" print_arg

   19 print_arg: list_expression
   20          | "string"

   21 list_expression: list_base list_ops

   22 list_base: list_creation
   23          | "identifier"

   24 list_ops: list_op list_ops
   25         | %empty

   26 list_op: filter_op
   27        | add_op
   28        | remove_op
   29        | select_op

   30 list_creation: "Peigengoo" "(" record_list ")"

   31 record_list: "[" record_list_content "]"

   32 record_list_content: record more_records
   33                    | %empty

   34 more_records: "," record more_records
   35             | %empty

   36 record: "{" pair more_pairs "}"

   37 more_pairs: "," pair more_pairs
   38           | %empty

   39 pair: "identifier" ":" value

   40 filter_op: "Gojo_Satoru" condition

   41 add_op: "+" "identifier" "=" value

   42 remove_op: "-" "identifier"

   43 select_op: "->" "(" identifier_list ")"

   44 identifier_list: "identifier" more_identifiers

   45 more_identifiers: "," "identifier" more_identifiers
   46                 | %empty

   47 condition: and_cond or_rest

   48 or_rest: "Shpioniro_Golubiro" and_cond or_rest
   49        | %empty

   50 and_cond: simple_cond and_rest

   51 and_rest: "Cheese_Rattatino" simple_cond and_rest
   52         | %empty

   53 simple_cond: field_ref operator value
   54            | "(" condition ")"

   55 field_ref: "identifier" field_suffix

   56 field_suffix: "." "identifier"
   57             | %empty

   58 operator: "=="
   59         | "!="
   60         | ">"
   61         | "<"
   62         | ">="
   63         | "<="

   64 value: "string"
   65      | "number"
   66      | "SIXSEVEN"
   67      | field_ref

   68 if_statement: "Tralalero_Tralala" condition statement_block optional_else "Hipocactus"

   69 optional_else: "Cappuccino_Assassino" statement_block
   70              | %empty

   71 for_loop: "Bombombini_Gusini" "identifier" "Trippi_Troppi" list_expression statement_block "Hipocactus"

   72 statement_block: statement statements


